class Student:

    def __init__(self, name, roll_no, branch):
        self.name = name
        self.roll_no = roll_no
        self.branch = branch

    def display(self):
        print("Student Name:", self.name)
        print("Roll No:", self.roll_no)
        print("Branch:", self.branch)
        print("----------------------")

s1 = Student("Jahnavi", 101, "ECE")
s2 = Student("Rahul", 102, "CSE")

s1.display()
s2.display()
