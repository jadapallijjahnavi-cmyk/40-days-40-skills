class Dog:
    def sound(self):
        print("Dog Barks")

class Cat:
    def sound(self):
        print("Cat Meows")

class Cow:
    def sound(self):
        print("Cow Moos")

animals = [Dog(), Cat(), Cow()]

for animal in animals:
    animal.sound()

