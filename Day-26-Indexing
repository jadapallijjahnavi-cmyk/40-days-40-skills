├── 01_create_index.sql

-- Day 26: Create Index

CREATE TABLE students (
    student_id INT PRIMARY KEY,
    name VARCHAR(50),
    email VARCHAR(100)
);

INSERT INTO students VALUES
(101, 'Jahnavi', 'jahnavi@gmail.com'),
(102, 'Ravi', 'ravi@gmail.com'),
(103, 'Priya', 'priya@gmail.com');

-- Create an index on email
CREATE INDEX idx_student_email
ON students(email);

-- Search using the indexed column
SELECT *
FROM students
WHERE email = 'jahnavi@gmail.com';

├── 02_drop_index.sql

-- Day 26: Drop Index

CREATE INDEX idx_student_email
ON students(email);

-- Remove the index
DROP INDEX idx_student_email
ON students;

