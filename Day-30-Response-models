#  FastAPI Response Model

from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI()


class StudentResponse(BaseModel):
    name: str
    age: int
    branch: str


@app.get("/students", response_model=StudentResponse)
def get_student():
    return {
        "name": "Jahnavi",
        "age": 20,
        "branch": "ECE"
    }

