break_examples.py
# Login attempts
correct_password = "python123"

for attempt in range(3):
    password = input("Enter password: ")

    if password == correct_password:
        print("Login Successful")
        break
    else:
        print("Wrong Password")
# Product search

products = ["Pen", "Book", "Bag", "Bottle"]

search = input("Enter product name: ")

for product in products:
    if product == search:
        print("Product Found")
        break
# Employee search

for emp_id in range(101, 106):
    if emp_id == 103:
        print("Employee Found:", emp_id)
        break

continue_examples.py
# Skip Employee ID 4

for emp_id in range(1, 8):

    if emp_id == 4:
        continue

    print("Employee ID:", emp_id)

nested_loops.py
# Batch and Student example

for batch in range(1, 4):
    print("Batch", batch)

    for student in range(1, 6):
        print(" Student", student)

    print()
# Star Pattern

for i in range(1, 6):
    for j in range(i):
        print("*", end="")
    print()

print()

# Number Pattern

for i in range(1, 6):
    for j in range(1, i + 1):
        print(j, end=" ")
    print()

